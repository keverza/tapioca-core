reference/
__pycache__/

.claude/settings.local.json
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp
*.npz
*.dxf
*.obj
*.stl
# Curated documentation media is tracked; other generated images remain ignored.
!docs/static/
!docs/static/*.gif
!docs/static/Logo.jpg
/AddOn/EvP/build_29
# The artifacts Build-AddOn29.ps1 copies into dist/ at the end of a build, so the
# shipped binaries are in one findable place. dist/ ITSELF IS TRACKED -- it
# carries the generated API docs -- so the BINARIES are ignored by EXTENSION
# rather than the folder, or a 15 MB .apx would land in every commit.
/dist/*.apx
/dist/*.dll
/dist/*.gha
/dist/*.pdb
/AddOn/EvP/NotebookUI/node_modules/
/AddOn/EvP/NotebookUI/dist/
# Dump DATA only. Was `*dump*`, which (core.ignorecase=true on Windows) also
# swallowed source folders like Commands/RoofDumpProbe/ — silently, so they were
# never committed and got lost. Keep these anchored to data dirs/extensions.
/dumps/
*.dump
/tapir-archicad-automation-main
.claude/settings.local.json
AddOn/EvP/command-sync.local.json
opencode.json
/03 Tapir + GeometryServer

.pytest_cache/
# Curated offline fixtures live in /dump/ and are intentionally trackable.

# Disposable run artifacts. Logs are never task evidence by themselves; record
# decisive excerpts in the owning task or a curated fixture instead.
/captures/
/tmp/
/evp-dryrun/
/AddOn/EvP/output/
*.log

/archive/experiments/*/build/

# shaderc is a BUILD-TIME tool, built on demand by tools/shaderc/Build-Shaderc.ps1.
# Its binary and build tree are not artefacts anyone should be pulling; the
# shaders it produces (ShadersBin/*.bin.h) ARE checked in, which is what makes
# an ordinary Build-AddOn29.ps1 independent of it.
AddOn/EvP/tools/shaderc/bin/
AddOn/EvP/tools/shaderc/build/
/dump

!AddOn/reference/
AddOn/reference/*
!AddOn/reference/CATALOG.yaml

# The Grasshopper worker's build tree. `dotnet publish` stages the shipping files
# in build_29/GhWorker/; bin/ and obj/ here are intermediates only.
AddOn/EvP/Sources/GhWorker/bin/
AddOn/EvP/Sources/GhWorker/obj/

# Dynamo ZeroTouch build intermediates; CMake stages the package in build_29/.
AddOn/EvP/Sources/TapiocaDynamo/bin/
AddOn/EvP/Sources/TapiocaDynamo/obj/
/AddOn/EvP/GraphUI/node_modules
/AddOn/EvP/GraphUI/dist/
/AddOn/EvP/Sources/GrasshopperComponents/obj
/AddOn/EvP/Sources/GrasshopperComponents/bin
/AddOn/EvP/Sources/GrasshopperComponents
