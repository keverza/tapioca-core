<Project Sdk="Microsoft.NET.Sdk">
  <!-- The canvas buttons for Tapioca.DynamoNodes' selection set, and nothing else.

       This is the ONLY Tapioca assembly that references WPF. It is loaded by
       DynamoSandbox, which runs on Microsoft.WindowsDesktop.App; the headless runner
       does not have that framework and is EXPECTED to fail to load this one. Dynamo
       catches that per assembly (PackageLoader.cs) and loads the rest of the package,
       which is why the split is safe rather than merely tidy. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Tapioca.DynamoNodesUI</AssemblyName>
    <RootNamespace>Tapioca.Nodes.UI</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TapiocaDynamoNodes\Tapioca.DynamoNodes.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="DynamoCore">
      <HintPath>$(DynamoRuntimeDir)\DynamoCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DynamoCoreWpf">
      <HintPath>$(DynamoRuntimeDir)\DynamoCoreWpf.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RequireDynamoRuntimeDir" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(DynamoRuntimeDir)' == ''">
    <Error Text="DynamoRuntimeDir must point to the pinned Dynamo runtime directory." />
  </Target>
</Project>
