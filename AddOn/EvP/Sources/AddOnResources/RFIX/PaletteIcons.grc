	"TapiocaMinusSquare"
}
'GICN' 32603 "Update selection" {
	"TapiocaRefresh"
}
'GICN' 32604 "Reselect elements" {
	"TapiocaSelectFace3d"
}
'GICN' 32605 "Clear selection" {
	"TapiocaSquareDashed"
}
