# EmbedBinary.cmake -- write INPUT as a C++ byte array NAME into header OUTPUT.
#   cmake -DINPUT=<file> -DOUTPUT=<header> -DNAME=<identifier> -P EmbedBinary.cmake
file (READ "${INPUT}" hex HEX)
string (LENGTH "${hex}" length)
math (EXPR bytes "${length} / 2")
string (REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," body "${hex}")
string (REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" body "${body}")
file (WRITE "${OUTPUT}"
    "// Generated by EmbedBinary.cmake from ${INPUT}; do not edit or commit.\n"
    "#pragma once\n"
    "static const unsigned char ${NAME}[${bytes}] = {\n${body}\n};\n")
