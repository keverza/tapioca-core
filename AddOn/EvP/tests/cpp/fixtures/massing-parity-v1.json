        {"guid":"slab:other","id":"O","bottom":0,"top":3,"outer":[20,0,30,0,30,10,20,10],"holes":[],"metadata":{"massing.buildingId":"tower","massing.floorHeight":3}}
      ]},
      "analytic": {"success":true,"rawArea":400.0,"rawVolume":1200.0,"floorCount":4},
      "expected": "massing-parity-v1.expected.json#GroupedBuildings"
    },
