      "name": "RectangularPrism",
      "sourceTest": "MassingSlices; SlabSlices; native analytic fixture",
      "basis": "20*10 footprint, 9 m height, three 3 m floors; area600, volume1800, perimeter60*height9 facade540",
      "input": {"mode":"build","storeys":[],"slabs":[{"guid":"slab:rectangle","id":"A","bottom":0,"top":9,"outer":[0,0,20,0,20,10,0,10],"holes":[],"metadata":{"massing.buildingId":"Tower","massing.floorHeight":3}}]},
      "analytic": {"success":true,"rawArea":600.0,"rawVolume":1800.0,"floorCount":3,"facadeArea":540.0},
      "expected": "massing-parity-v1.expected.json#RectangularPrism"
    },
    {
      "name": "CourtyardPrism",
      "sourceTest": "MassingFacade.MixedPrismAndOperatedBodyKeepCourtyardAndSharedWallExclusion; MassingBake.CountedSlicesRetainHolesSeparateIslandsAndPhysicalElevation",
      "basis": "10*10 outer less2*2 hole: 96*3 floor area,96*9 volume,(40+8)*9 courtyard facade",
      "input": {"mode":"build","storeys":[],"slabs":[{"guid":"slab:courtyard","id":"C","bottom":0,"top":9,"outer":[0,0,10,0,10,10,0,10],"holes":[[4,4,6,4,6,6,4,6]],"metadata":{"massing.buildingId":"Courtyard","massing.floorHeight":3}}]},
      "analytic": {"success":true,"rawArea":288.0,"rawVolume":864.0,"floorCount":3,"facadeArea":432.0},
      "expected": "massing-parity-v1.expected.json#CourtyardPrism"
    },
    {
      "name": "ThinExcludedFloor",
      "sourceTest": "MassingSlices.ThinSelectedSlabRetainsOneFloorButIsGrayAndExcludedWithoutAnEnvelope",
      "basis": "10*10*0.3 prism retains one gray floor below1.6m clearance: counted0,excluded100,volume30",
      "input": {"mode":"build","storeys":[],"slabs":[{"guid":"slab:thin","id":"T","bottom":0,"top":0.3,"outer":[0,0,10,0,10,10,0,10],"holes":[],"metadata":{}}]},
      "analytic": {"success":true,"rawArea":0.0,"excludedArea":100.0,"rawVolume":30.0,"floorCount":1},
      "expected": "massing-parity-v1.expected.json#ThinExcludedFloor"
    },
    {
      "name": "HalfEnvelope",
      "sourceTest": "MassingSlices.Intersect; MassingSlices.Build envelope clipping regressions",
      "basis": "10*10*9 prism intersected by x5..10 envelope: raw300/900,allowed150/450 across three floors",
      "input": {"mode":"build","envelope":"halfEnvelope","storeys":[],"slabs":[{"guid":"slab:clipped","id":"E","bottom":0,"top":9,"outer":[0,0,10,0,10,10,0,10],"holes":[],"metadata":{"massing.floorHeight":3}}]},
      "analytic": {"success":true,"rawArea":300.0,"allowedArea":150.0,"rawVolume":900.0,"allowedVolume":450.0,"floorCount":3,"clipped":true},
      "expected": "massing-parity-v1.expected.json#HalfEnvelope"
    },
    {
