      "basis": "Tower lower0..3 plus upper3..9 share ID; separate case-sensitive tower atx20 has one floor. Four100m2 floor rows,1200m3 volume",
      "input": {"mode":"build","storeys":[],"slabs":[
        {"guid":"slab:lower","id":"L","bottom":0,"top":3,"outer":[0,0,10,0,10,10,0,10],"holes":[],"metadata":{"massing.buildingId":"Tower","massing.floorHeight":3}},
